{
  "name": "gmail-unsubscribe-tool",
  "version": "1.0.0",
  "description": "Gmail unsubscribe tool with retro Windows 95/98 UI",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "npm run dev"
  },
  "keywords": ["gmail", "unsubscribe", "windows95", "retro"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
